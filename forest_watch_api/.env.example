# Earthdata Login (required for remote NISAR data streaming; ASF search alone may work without it)
EARTHDATA_USERNAME=radomilan
EARTHDATA_PASSWORD=TbtB?AduPp=/8*=

# Optional local development mode: use a previously downloaded HDF5 granule.
# Set both values; do not commit the HDF5 file to git.
NISAR_LOCAL_FILE=
NISAR_LOCAL_GRANULE_ID=

# Frontend origins, comma-separated. For local Vite use http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Streaming block size (bytes). HDF5 reads only needed byte ranges over HTTPS.
NISAR_STREAM_BLOCK_SIZE=2097152
